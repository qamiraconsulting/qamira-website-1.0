# Copy to .env.local for local development. In production (Vercel), set
# these as project Environment Variables in the Vercel dashboard instead --
# never commit real values.

# Anthropic (AI Business Assessment report generation) -- SECRET, server-side
# only. Used by /api/assessment.ts (a Vercel serverless function), never
# exposed to the browser. Set this in the Vercel dashboard under
# Settings -> Environment Variables, not in this file.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Sheets lead log (AI Business Assessment submissions) -- SECRET,
# server-side only. Used by /api/assessment.ts to append one row per
# completed assessment to a Google Sheet, via a Google Apps Script Web App
# bound to the sheet (Extensions -> Apps Script, no GCP project needed).
# SHEETS_WEBHOOK_URL is the deployed web app's /exec URL.
# SHEETS_WEBHOOK_SECRET is a random string you make up -- set the same
# value as a Script Property in the Apps Script project so it can reject
# unauthenticated requests (the web app is deployed with "Anyone" access).
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/exec
SHEETS_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Meta (Facebook) Pixel -- OPTIONAL OVERRIDE. Normally leave this unset.
#
# The live pixel ID is hardcoded in src/lib/metaPixel.ts and only fires on
# www.qamiraconsulting.com, so localhost and Vercel preview deploys never
# send events. Set this only to point a non-production host at a different
# (throwaway) dataset for testing.
# VITE_META_PIXEL_ID=000000000000000

# Meta Conversions API access token -- SECRET, server-side only. Generated
# in Events Manager -> Datasets -> Settings -> Conversions API (direct
# integration, NOT the Gateway product). Used by api/_meta-capi.ts to send
# server-side copies of Lead/Contact conversions.
#
# Deliberately has NO VITE_ prefix: anything prefixed VITE_ is compiled
# into the browser bundle and becomes public. This token must not be.
# Set it in the Vercel dashboard (Production, marked Sensitive), not here.
# Without it, sendMetaEvent() is a no-op and only the browser pixel reports.
META_CAPI_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
