# Copy to .env.local for local development. In production (Vercel), set
# these as project Environment Variables in the Vercel dashboard instead --
# never commit real values.

# Clerk (auth) -- publishable key is public/safe to expose client-side.
# From: Clerk dashboard -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic (AI Business Assessment report generation) -- SECRET, server-side
# only. Used by /api/assessment.ts (a Vercel serverless function), never
# exposed to the browser. Set this in the Vercel dashboard under
# Settings -> Environment Variables, not in this file.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
